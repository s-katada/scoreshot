{
  "name": "scoreshot",
  "version": "0.1.0",
  "description": "ピアノ譜のエディタ (macOS / iPadOS / iOS)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/omr/fetch-models.mjs && tsc && vite build",
    "preview": "vite preview",
    "tauri": "cargo tauri",
    "check": "vite build -c vite.scripts.config.ts --ssr scripts/check.ts --outDir .tmp-check && node .tmp-check/check.js",
    "omr:models": "node scripts/omr/fetch-models.mjs",
    "omr:segment": "vite build -c vite.scripts.config.ts --ssr scripts/omr/segment-page.ts --outDir .tmp-omr/segment && node .tmp-omr/segment/segment-page.js",
    "omr:corpus": "vite build -c vite.scripts.config.ts --ssr scripts/omr/make-corpus.ts --outDir .tmp-omr/corpus && node .tmp-omr/corpus/make-corpus.js",
    "omr:degrade": "vite build -c vite.scripts.config.ts --ssr scripts/omr/degrade.ts --outDir .tmp-omr/degrade && node .tmp-omr/degrade/degrade.js",
    "omr:evaluate": "vite build -c vite.scripts.config.ts --ssr scripts/omr/evaluate.ts --outDir .tmp-omr/evaluate && node .tmp-omr/evaluate/evaluate.js",
    "omr:inspect": "vite build -c vite.scripts.config.ts --ssr scripts/omr/inspect.ts --outDir .tmp-omr/inspect && node .tmp-omr/inspect/inspect.js"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.3",
    "@tauri-apps/plugin-fs": "2.5.2",
    "fflate": "0.8.3",
    "onnxruntime-web": "1.30.0",
    "opensheetmusicdisplay": "^2.1.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tone": "^15.1.22"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "@xmldom/xmldom": "0.9.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
