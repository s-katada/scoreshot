<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  iOS 27 SDK (Xcode 27) でビルドしたアプリは UIScene ライフサイクルの
	  採用が必須になった。宣言が無いと起動直後に SIGTRAP で落ちる:
	    Application failed to launch: UIScene life cycle is required
	    for apps built with this SDK.

	  tao 0.35.3 はこの宣言があっても UIApplicationSupportsMultipleScenes が
	  false だとウィンドウをシーンにつながず、画面に何も出なかった (#7)。
	  tao 0.37 で直ったものを src-tauri/patches/tao に持ち込んで使っている
	  (Tauri 2 系は tao 0.35 のため)。

	  UISceneDelegateClassName は書かない。tao がシーンの設定を問われたときに
	  TaoSceneDelegate を実行時に割り当てる。
	-->
	<!-- 楽譜をカメラで撮って読み取る (#2)。無いとカメラを使おうとした時点で落とされる -->
	<key>NSCameraUsageDescription</key>
	<string>楽譜を撮影して読み取るためにカメラを使います。</string>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneConfigurationName</key>
					<string>Default Configuration</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
